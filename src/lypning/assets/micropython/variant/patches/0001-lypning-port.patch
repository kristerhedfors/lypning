+++ b/lib/re1.5/recursiveloop.c
@@ -4,6 +4,28 @@
 
 #include "re1.5.h"
 
+// lypning: one CLASS match consumes one CHARACTER, not one byte.
+//
+// re1.5 matches bytes. charclass.c already treats every byte >= 0x80 as a word
+// constituent, which keeps `\w+` from shredding "räksmörgås" into
+// ['r','ksm','rg','s'] — but that works only because `+` happens to consume the
+// remaining bytes. An UNQUANTIFIED class matched exactly one byte and left the
+// cursor mid-character, so `re.findall(r"\w", "räksmörgås")` produced spans
+// that could not be sliced and raised UnicodeError, where CPython returns the
+// ten characters. The same held for `.` and for any negated class: `[^a]`
+// matched a third of an "ö".
+//
+// Advancing over the UTF-8 continuation bytes after a consuming instruction
+// makes each of those consume a whole character, which is what CPython's `.`
+// and its character classes do. A literal Char is deliberately excluded — see
+// the case below.
+#define LYPNING_SKIP_CONT(sp, end) \
+	do { \
+		while ((sp) < (end) && ((unsigned char)*(sp) & 0xC0) == 0x80) { \
+			(sp)++; \
+		} \
+	} while (0)
+

index 2553b40..6d8bf04 100644
--- a/lib/re1.5/charclass.c
+++ b/lib/re1.5/charclass.c
@@ -33,7 +33,25 @@ int _re1_5_namedclassmatch(const char *pc, const char *sp)
             off ^= 1;
         }
     } else { // w
-        if (!((*sp >= 'A' && *sp <= 'Z') || (*sp >= 'a' && *sp <= 'z') || (*sp >= '0' && *sp <= '9') || *sp == '_')) {
+        // lypning: bytes >= 0x80 are word constituents.
+        //
+        // re1.5 matches BYTES, and \w was ASCII-only. Against a UTF-8 str that
+        // does not merely drop non-English words, it SHREDS them:
+        // re.findall(r"\w+", "räksmörgås") returned ['r', 'ksm', 'rg', 's'] —
+        // a plausible-looking wrong answer with a zero exit code, which is the
+        // failure class docs/MICROPYTHON.md exists to prevent, and the one a reader
+        // is least likely to notice.
+        //
+        // CLAUDE.md invariant 6 requires equal Swedish and English support in
+        // every deterministic gate, so this is a correctness fix, not a nicety.
+        // Treating every lead and continuation byte as a word character keeps
+        // each multi-byte character whole and inside the match, which matches
+        // CPython's unicode-aware \w for every letter — the divergence that
+        // remains is that a non-ASCII PUNCTUATION character would also be
+        // absorbed, which is a far smaller and non-silent error than cutting a
+        // word in half.
+        if (!((*sp >= 'A' && *sp <= 'Z') || (*sp >= 'a' && *sp <= 'z') || (*sp >= '0' && *sp <= '9') || *sp == '_'

+			// lypning: a LITERAL stays byte-wise. A multi-byte character in
+			// the pattern compiles to a SEQUENCE of Char instructions, so
+			// skipping continuation bytes here would consume it twice over.
 			if(*sp != *pc++)
 				return 0;
-			MP_FALLTHROUGH
+			sp++;
+			continue;
 		case Any:
 			sp++;
+			LYPNING_SKIP_CONT(sp, input->end);
 			continue;
 		case Class:
 		case ClassNot:
@@ -32,12 +59,14 @@ recursiveloop(char *pc, const char *sp, Subject *input, const char **subp, int n
 				return 0;
 			pc += *(unsigned char*)pc * 2 + 1;
 			sp++;
+			LYPNING_SKIP_CONT(sp, input->end);
 			continue;
                 case NamedClass:
 			if (!_re1_5_namedclassmatch(pc, sp))
 				return 0;
 			pc++;
 			sp++;
+			LYPNING_SKIP_CONT(sp, input->end);
 			continue;

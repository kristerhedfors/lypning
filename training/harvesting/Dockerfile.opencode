FROM node:22.19.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global opencode-ai@1.18.31 \
    && test "$(opencode --version)" = "1.18.31"
COPY worker.py capture.js /app/
RUN mkdir -p /opt/template/.config/opencode /work \
    && cd /opt/template/.config/opencode \
    && npm install --save-exact @opencode-ai/plugin@1.18.31 \
    && HOME=/opt/template OPENCODE_DISABLE_AUTOUPDATE=true opencode models >/dev/null \
    && chmod -R a+rX /opt/template && chown 65534:65534 /work
ENV HOME=/work/home
WORKDIR /work
USER 65534:65534
ENTRYPOINT ["python3", "-I", "/app/worker.py"]
